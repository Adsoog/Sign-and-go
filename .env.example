# SignBox Environment Configuration
DJANGO_SECRET_KEY=django-insecure-signbox-change-in-production-super-secret-key-12345
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Storage Configuration
# SQLite is the default for local development. Set DATABASE_URL or POSTGRES_* for PostgreSQL.
DATABASE_URL=sqlite:///db.sqlite3

# Security & Encryption Key for PKCS#12 Certificate Vault (AES-GCM / Fernet)
# IMPORTANT: Store securely outside repository. If lost, encrypted certificates cannot be decrypted!
SIGNBOX_ENCRYPTION_KEY=your-32-byte-base64-encoded-encryption-key-here

# Base URL for verification QR codes & public links
SIGNBOX_BASE_URL=http://localhost:8000

# File Upload limits (in bytes: 25MB max document, 10MB cert)
MAX_DOCUMENT_SIZE_BYTES=26214400
MAX_CERTIFICATE_SIZE_BYTES=10485760
